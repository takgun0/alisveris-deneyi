{
  "name": "sepete-ekle-deneyi",
  "private": true,
  "type": "module",
  "description": "Sepete Ekle butonunun konum ve kontrast etkisini ölçen deney sistemi",
  "scripts": {
    "williams": "node scriptler/williams.mjs",
    "kontrast": "node scriptler/kontrast.mjs",
    "site": "node scriptler/gelistirme_sunucusu.mjs",
    "site:sahte-api": "node scriptler/gelistirme_sunucusu.mjs --sahte-api --sahte-veri=150",
    "test:birim": "node --test \"testler/birim/**/*.test.mjs\"",
    "test:vt": "node --test --test-concurrency=1 \"testler/vt/**/*.test.mjs\"",
    "test": "npm run kontrast && npm run test:birim",
    "sahte-veri": "node scriptler/sahte_veri.mjs",
    "test:e2e": "playwright test",
    "damgala": "node scriptler/surum_damgala.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "pg": "^8.23.1",
    "supabase": "^2.122.1"
  }
}
